# Booking Option B — live Guesty availability.
#
# Copy to .env.local for local work, or set these in the deployment environment.
# NEVER commit real values. .env is gitignored; .env.example is not, so this file
# must only ever contain placeholders.
#
# With either unset, the site runs booking Option A (deep-link) and makes no
# Guesty requests at all. See docs/BOOKING-MODES.md.

GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=

# Kill switch. Set to `deeplink` to force Option A even with valid credentials.
# Leave unset for normal operation.
# BOOKING_MODE=deeplink
